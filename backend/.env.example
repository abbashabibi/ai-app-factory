# Runtime
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://YOUR-WEB-DOMAIN
AUTH_REQUIRED=true

# Required for production auth
SESSION_SECRET=replace-with-at-least-32-random-characters

# Durable storage (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set to disable only when your database explicitly does not support TLS.
DATABASE_SSL=require
DB_POOL_MAX=10

# AI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_TIMEOUT_MS=60000

# GitHub source provider
GITHUB_TOKEN=
GITHUB_REPOSITORY=abbashabibi/ai-app-factory
GITHUB_API_VERSION=2026-03-10

# Codemagic build provider
CODEMAGIC_API_TOKEN=
CODEMAGIC_APP_ID=
CODEMAGIC_WORKFLOW_ID=android-debug

# Admin-only license issuance
ADMIN_API_KEY=
